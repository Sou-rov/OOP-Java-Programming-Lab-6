public class Cat {
    String name;
    int age;
    public Cat() 
    {
        name = "Unknown";
        age = 0;
    }
    public void display() 
    {
        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
    }
    public static void main(String[] args) 
    {
        Cat cat = new Cat(); 
        cat.display();
    }
}
