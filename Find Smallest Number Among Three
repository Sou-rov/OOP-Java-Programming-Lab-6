public class SmallestNumber {
    public static int findSmallest(int a, int b, int c) 
    {
        int smallest = a;
        if (b < smallest) 
        {
            smallest = b;
        }
        if (c < smallest) 
        {
            smallest = c;
        }
        return smallest;
    }
    public static void main(String[] args) 
    {
        int num1 = 15;
        int num2 = 8;
        int num3 = 20;
        System.out.println("The smallest number is: " + findSmallest(num1, num2, num3));
    }
}
